// CuteCat 的 Windows 资源：EXE 图标 + 版本信息
// 版本号需与 CMakeLists.txt 的 project(... VERSION ...) 保持一致
// 注意：本文件保持纯 ASCII，避免 rc.exe 在不同代码页下解析异常

IDI_APPICON ICON "resources/icons/app.ico"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "hbxdss"
            VALUE "FileDescription", "CuteCat Desktop Pet"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "CuteCat"
            VALUE "LegalCopyright", "AGPL-3.0 (https://github.com/hbxdss/CuteCat)"
            VALUE "OriginalFilename", "CuteCat.exe"
            VALUE "ProductName", "CuteCat"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END